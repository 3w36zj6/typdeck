{
  "name": "typdeck",
  "version": "0.2.0",
  "description": "Compile Typst slides into a web stage and presenter view",
  "keywords": [
    "typst",
    "cli",
    "slide",
    "deck",
    "presentation"
  ],
  "type": "module",
  "packageManager": "aube@2.7.0",
  "repository": "https://github.com/3w36zj6/typdeck",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/3w36zj6"
  },
  "license": "MIT",
  "author": "3w36zj6",
  "bin": {
    "typdeck": "bin/index.js"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "aube run build:client && aube run build:server",
    "build:client": "vite build",
    "build:server": "bun scripts/buildServer.ts",
    "prepack": "aube run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint --fix src/ scripts/",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@fastify/send": "^4.1.1",
    "@optique/core": "1.3.6",
    "@optique/run": "1.3.6",
    "chokidar": "^5.0.0",
    "pdfjs-dist": "6.4.299",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-icon/solid": "^2.3.0",
    "@iconify-json/lucide": "^1.2.142",
    "@types/bun": "latest",
    "@types/node": "26.6.4",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^15.15.0",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "solid-js": "^1.9.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.4.0"
  }
}
