{
  "name": "typdeck",
  "version": "0.2.0",
  "description": "Compile Typst slides into a web stage and presenter view",
  "keywords": [
    "typst",
    "cli",
    "slide",
    "deck",
    "presentation"
  ],
  "type": "module",
  "packageManager": "aube@2.7.0",
  "repository": "https://github.com/3w36zj6/typdeck",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/3w36zj6"
  },
  "license": "MIT",
  "author": "3w36zj6",
  "bin": {
    "typdeck": "bin/index.js"
  },
  "files": [
    "bin",
    "public"
  ],
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "aube run build:client && aube run build:server",
    "build:client": "vite build",
    "build:server": "esbuild index.ts --bundle --platform=node --outfile=bin/index.js --packages=external --format=esm --minify",
    "prepack": "aube run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "tsc": "tsc -b"
  },
  "dependencies": {
    "@fastify/send": "^4.1.1",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "pdfjs-dist": "6.3.289",
    "valibot": "^1.5.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@iconify-icon/solid": "^2.3.0",
    "@types/bun": "latest",
    "@types/node": "26.6.4",
    "@types/yargs": "^17.0.33",
    "esbuild": "^0.25.0",
    "eslint": "^9.19.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "solid-js": "^1.9.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
